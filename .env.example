# ══════════════════════════════════════════════
# CloudOptima — Environment Configuration
# ══════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM Provider ───────────────────────────────
# Options: mock | nvidia | azure | openai | anthropic | google
LLM_PROVIDER=mock

# Nvidia NIM API (free tier: https://build.nvidia.com)
NVIDIA_API_KEY=                          # Your Nvidia NIM API key (https://build.nvidia.com, free tier)

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01

# OpenAI (direct) — platform.openai.com
OPENAI_API_KEY=

# Anthropic Claude — console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini — aistudio.google.com
GOOGLE_API_KEY=

# Model settings
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=30

# ── Cost-aware LLM Routing (Phase 7.5 / 7.6) ──────
# When true, each agent call is routed to the cheapest enabled provider with
# credentials, failing over automatically (e.g. free Nvidia NIM -> Azure).
ROUTING_ENABLED=false
# Providers eligible for routing: mock | nvidia | azure | openai | anthropic | google
# (order = tie-break; price still decides who is tried first)
ROUTING_PROVIDERS=openai,azure,anthropic,google,nvidia
# Soft USD cap on estimated input cost before a provider is skipped
ROUTING_MAX_COST_PER_REQUEST=0.005
# Per-provider timeout (seconds) for routed clients — fail fast on dead keys
ROUTING_TIMEOUT=10.0
# Nvidia NIM models (free tier: https://build.nvidia.com)
LLM_NVIDIA_MODEL=meta/llama-3.3-70b-instruct
LLM_NVIDIA_FAST_MODEL=meta/llama-3.1-8b-instruct
# Azure OpenAI models
LLM_AZURE_MODEL=gpt-4o-mini
LLM_AZURE_FAST_MODEL=gpt-4o-mini
# OpenAI (direct) models
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_OPENAI_FAST_MODEL=gpt-4o-mini
# Anthropic Claude models
LLM_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
LLM_ANTHROPIC_FAST_MODEL=claude-3-5-haiku-20241022
# Google Gemini models
LLM_GOOGLE_MODEL=gemini-2.0-flash
LLM_GOOGLE_FAST_MODEL=gemini-2.0-flash

# ── Demo Mode ──────────────────────────────────
# When true, uses MockClient — no API keys needed, instant responses
DEMO_MODE=true

# ── Debug ──────────────────────────────────────
# Verbose logging and debug output
DEBUG=false

# ── Cache ──────────────────────────────────────
CACHE_TTL_HOURS=24
CACHE_MAX_SIZE_MB=200

# ── Rate Limiting ──────────────────────────────
RATE_LIMIT_PER_SESSION=1
RATE_LIMIT_GLOBAL_PER_HOUR=60
# Round-3 P2: 'memory' for a single process, 'redis' for a shared quota
# across scaled-out workers (requires the 'redis' extra).
RATE_LIMIT_BACKEND=memory
REDIS_URL=

# ── Azure ──────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_DEFAULT_REGION=uaenorth

# ── Observability ──────────────────────────────
LOG_LEVEL=INFO
AUDIT_LOG_DIR=logs
AUDIT_RETENTION_DAYS=90

# ── Security ───────────────────────────────────
MAX_INPUT_LENGTH=5000

# ── Azure AI Content Safety (optional) ─────────
# Set to false to allow demo mode / mock provider without safety
CONTENT_SAFETY_ENABLED=false
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_API_KEY=