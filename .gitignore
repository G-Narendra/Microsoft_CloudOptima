# ──────────────────────────────────────────────
#  Python
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.so

# ──────────────────────────────────────────────
#  Virtual environment (never commit these)
# ──────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.conda/

# ──────────────────────────────────────────────
#  Environment & secrets (never commit real keys)
# ──────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ──────────────────────────────────────────────
#  Logs & runtime output
# ──────────────────────────────────────────────
*.log
logs/

# ──────────────────────────────────────────────
#  Local data (generated at runtime)
# ──────────────────────────────────────────────
data/
# Compliance RAG vector store
compliance_rag/

# ──────────────────────────────────────────────
#  Red-team / evaluation runtime artifacts
# ──────────────────────────────────────────────
# PyRIT creates its own SQLite DB on every campaign run — it changes
# constantly and must not be committed.
scripts/redteam/*.db
scripts/redteam/*.db-*
# Evaluation output files (generated by scripts/evaluate)
scripts/evaluate/results/

# ──────────────────────────────────────────────
#  Caches — test, type, lint, coverage
# ──────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ──────────────────────────────────────────────
#  IDE / editors
# ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.ropeproject/
.vscode-server/

# ──────────────────────────────────────────────
#  OS junk
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────
#  Streamlit
# ──────────────────────────────────────────────
.streamlit/

# ──────────────────────────────────────────────
#  Personal documents — NEVER pushed to GitHub
# ──────────────────────────────────────────────
# Narendra's private meeting-prep doc (story, Q&A, review logs)
narendra_doc.html
# The external principal-engineer review notes
review_cloudoptima.md

# ──────────────────────────────────────────────
#  Scratch / debug files (safe to delete)
# ──────────────────────────────────────────────
*_debug*.py
_bench*.py
